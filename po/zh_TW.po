#: src/McBopomofo.cpp
msgid ""
"# Text templates. Each line is a code, a tab, and the text. Write \\n for a "
"line break.\n"
"# Press ` and type the code, then Enter to insert the text. Press ` again "
"for the symbol table.\n"
"# The following are examples. Edit or remove them as you like.\n"
"addr\t100 Main Street, Springfield\n"
"tel\t+1 555 0100\n"
"em\tname@example.com\n"
"sig\tBest regards,\\nJohn Doe\n"
msgstr ""
"# 文字範本：一行一筆，代碼、Tab、內容。內容要換行請寫 \\n。\n"
"# 按 ` 後輸入代碼，按 Enter 送出；再按一次 ` 開啟符號表。\n"
"# 以下是範例，請改成自己的內容，或刪除不需要的。\n"
"addr\t台北市中正區重慶南路一段 122 號\n"
"tel\t02-1234-5678\n"
"em\tname@example.com\n"
"sig\t謝謝您！\\n王小明 敬上\n"

