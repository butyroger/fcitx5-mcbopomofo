FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ pkg-config fcitx5 libfcitx5core-dev libfcitx5config-dev \
    libfcitx5utils-dev fcitx5-modules-dev cmake extra-cmake-modules gettext \
    libfmt-dev libicu-dev libjson-c-dev \
    libgtest-dev libgmock-dev ninja-build file \
    && rm -rf /var/lib/apt/lists/*
